config TINYBLE
	bool "tinyble: minimal BLE peripheral host over raw HCI"
	depends on BT_HCI_RAW

config TINYBLE_MATTER_GATT
	bool "Matter commissioning GATT table"
	depends on TINYBLE
	default y

config TINYBLE_TINYTALK
	bool "tinytalk's BLE transport (matter_ble.h) on tinyble"
	depends on TINYBLE_MATTER_GATT && TINYTALK && !TINYTALK_BLE
	select TINYTALK_HAS_BLE
	select POLL
